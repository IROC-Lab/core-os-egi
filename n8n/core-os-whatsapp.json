   "name": "Mensagem chegou (Evolution)",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "webhookId": "core-os-whatsapp",
   "parameters": {
    "httpMethod": "POST",
