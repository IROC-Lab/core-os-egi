    "responseMode": "onReceived",
    "options": {}
   }
  },
  {
   "id": "a2",
   "name": "Conversa individual?",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    260,
    0
   ],
   "parameters": {
    "jsCode": "// Repassa pro painel toda mensagem de conversa individual (grupo, status e canal ficam de fora).\n// Quem decide quem pode dar ordens é o painel (Configurações › WhatsApp), então trocar número não mexe aqui.\n// Respostas do cérebro no chat \"Você\" começam com um caractere invisível (⁣) e são ignoradas (sem loop).\nconst saida = [];\nfor (const item of $input.all()) {\n  const b = item.json.body || item.json;\n  const d = b.data || {};\n  const chave = d.key || {};\n  const remoto = String(chave.remoteJid || '');\n  if (!remoto || remoto.endsWith('@g.us') || remoto.endsWith('@broadcast') || remoto.endsWith('@newsletter')) continue;\n  const chat = [chave.remoteJidAlt, chave.senderPn, remoto].find((j) => String(j || '').endsWith('@s.whatsapp.net')) || '';\n  if (!chat) continue;\n  const m = d.message || {};\n  const texto = m.conversation || m.extendedTextMessage?.text || '';\n  if (texto.startsWith('⁣')) continue;\n  const ehAudio = d.messageType === 'audioMessage' || Boolean(m.audioMessage);\n  const tipo = texto ? 'texto' : (ehAudio ? 'audio' : 'outro');\n  if (tipo === 'outro' && /reaction|protocol|senderKey|edited|poll|sticker/i.test(String(d.messageType))) continue;\n  saida.push({ json: { texto, tipo, deMim: Boolean(chave.fromMe), chat, eu: String(b.sender || ''), msgId: String(chave.id || ''), remoteJid: remoto, fromMe: Boolean(chave.fromMe) } });\n}\nreturn saida;"
   }
  },
  {
   "id": "f1",
   "name": "É áudio?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    520,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.tipo }}",
       "rightValue": "audio",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "b1",
   "name": "Baixa áudio (Evolution)",
