      }
     ]
    },
    "options": {
     "timeout": 120000
    }
   }
  },
  {
   "id": "b4",
   "name": "Vira texto",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1580,
    -160
   ],
   "parameters": {
    "jsCode": "// Junta a transcrição com os dados da mensagem original e manda como texto.\nconst orig = $('Conversa individual?').first().json;\nconst t = String($json.text || '').trim();\nreturn [{ json: { texto: t ? '🎤 ' + t : '', tipo: t ? 'texto' : 'audio', deMim: orig.deMim, chat: orig.chat, eu: orig.eu } }];"
   }
  },
  {
