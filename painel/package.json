    "@xterm/xterm": "5.5.0",
    "express": "5.1.0",
    "marked": "16.4.1",
    "pg": "8.13.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17"
  },
  "packageManager": "pnpm@10.34.9",
