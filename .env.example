# EGI Brand · variáveis da PLATAFORMA (Coolify > Environment Variables). Nunca suba este arquivo preenchido.
# As variáveis de cada EMPRESA (chaves de API do cliente) não ficam aqui: são cadastradas no painel
# (admin: ficha da empresa > Variáveis; cliente: Configurações > Variáveis), cifradas no banco.

# --- obrigatórias ---
BANCO_SENHA=                    # senha do Postgres dedicado (openssl rand -hex 24)
EGI_MASTER_KEY=                 # openssl rand -hex 32  ·  GUARDE NUM COFRE: perder = perder as variáveis das empresas
EGI_PUBLIC_URL=https://brand.appegi.com.br
EGI_ADMIN_EMAIL=voce@appegi.com.br
EGI_ADMIN_SENHA=                # 10+ caracteres com letras e números (só cria o 1º admin)

# --- Asaas (cobrança recorrente) ---
ASAAS_API_KEY=                  # chave da conta (sandbox primeiro!)
ASAAS_AMBIENTE=sandbox          # sandbox | producao
ASAAS_WEBHOOK_TOKEN=            # openssl rand -hex 24; o MESMO no webhook do Asaas (URL: <EGI_PUBLIC_URL>/hooks/asaas)
EGI_DIAS_SUSPENSAO=5            # dias de atraso até suspender
EGI_DIAS_LEMBRETE=3             # dia do lembrete antes da suspensão
EGI_SETUP_VENCIMENTO_DIAS=0     # setup vence no dia da contratação

# --- canais ---
EVO_URL=https://evo.appegi.com.br
EVO_KEY=                        # apikey global da Evolution (fica só na plataforma)
EGI_AVISOS_EVO_INSTANCIA=       # instância de WhatsApp da EGI que manda os avisos de cobrança (vazio = usa a da empresa)
EGI_SUPORTE_CONTATO=            # aparece nos avisos, ex.: WhatsApp (27) 99999-9999
GROQ_API_KEY=                   # transcrição de áudio (gsk_...)

# --- capacidade ---
EGI_MAX_PARALELO=3
